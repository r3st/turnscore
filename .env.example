# ---------------------------------------------------------------------------
# TurnScore — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control!
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Domain (production only)
# Used by Traefik for TLS certificate + router rule.
# ---------------------------------------------------------------------------
DOMAIN=turnscore.example.com

# ---------------------------------------------------------------------------
# Let's Encrypt (production only)
# Email for expiry notifications from ACME / Let's Encrypt.
# ---------------------------------------------------------------------------
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Docker GID (production only)
# GID of the docker group on the host so socket-proxy can read the socket.
# Find with: getent group docker | cut -d: -f3
# ---------------------------------------------------------------------------
DOCKER_GID=999

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_USER=app
DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Auth — Google OAuth
# Create credentials at: https://console.cloud.google.com/
# Authorized redirect URI: https://your-domain.com/api/v1/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the Authorized redirect URI configured in Google Cloud Console.
OAUTH_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# JWT
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# ---------------------------------------------------------------------------
# Legal texts (Imprint + Privacy Policy)
# Copy legal/*.example.md to legal/*.md and fill in real content.
# The ./legal directory is mounted read-only into the container.
# ---------------------------------------------------------------------------
LEGAL_PATH=./legal

# ---------------------------------------------------------------------------
# MinIO (production object storage)
# Generate credentials with: openssl rand -hex 16
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=changeme-access-key
MINIO_SECRET_KEY=changeme-secret-key
MINIO_BUCKET=turnscore
MINIO_REGION=eu-central-1

# ---------------------------------------------------------------------------
# File Storage
# Production uses MinIO (s3). Local dev uses local filesystem.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local

# S3 (only needed if STORAGE_BACKEND=s3, e.g. AWS or Cloudflare R2 instead of MinIO)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Logging
# Levels: debug | info | warn | error
# ---------------------------------------------------------------------------
LOG_LEVEL=info
